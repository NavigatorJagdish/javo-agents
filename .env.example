# Javo Agents Local Runtime Configuration
JAVO_APP_NAME="Javo Agents"
JAVO_DEBUG=false
JAVO_LOG_LEVEL=INFO
JAVO_HOST=127.0.0.1
JAVO_PORT=8000
JAVO_SECRET_KEY=replace-with-random-64-char-secret
JAVO_ENCRYPTION_KEY=replace-with-random-encryption-passphrase

# Database
JAVO_DATABASE_URL=sqlite+aiosqlite:///./javo_agents.db
JAVO_SCHEDULER_DB_URL=sqlite:///./scheduler_jobs.db

# Content & Storage Paths
JAVO_CONTENT_ROOT=./content
JAVO_UPLOAD_DIR=./uploads
JAVO_BACKUP_DIR=./backups
JAVO_THUMBNAIL_DIR=./thumbnails

# AI Providers
JAVO_DEFAULT_AI_PROVIDER=ollama
JAVO_OLLAMA_BASE_URL=http://localhost:11434
JAVO_OLLAMA_DEFAULT_MODEL=llama3.2
JAVO_GEMINI_API_KEY=
JAVO_GEMINI_MODEL=gemini-2.0-flash
JAVO_OPENAI_API_KEY=
JAVO_OPENAI_BASE_URL=https://api.openai.com/v1
JAVO_OPENAI_MODEL=gpt-4o-mini

# Budgets & Limits (Zero-Cost Default)
JAVO_AI_DAILY_BUDGET=0.0
JAVO_AI_MONTHLY_BUDGET=0.0
JAVO_MAX_CONCURRENT_AGENTS=5

# Telegram Bot (Optional)
JAVO_TELEGRAM_BOT_TOKEN=
JAVO_TELEGRAM_WEBHOOK_URL=
