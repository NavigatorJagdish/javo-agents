{
  "name": "@javo/windows-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Javo Agents Windows Electron Desktop Shell",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test tests/*.test.cjs",
    "start": "npm run build && electron .",
    "verify:package": "node scripts/verify-package.cjs",
    "dist:win": "npm run build && npm run verify:package && electron-builder --win --publish never --config electron-builder.yml"
  },
  "dependencies": {
    "electron-updater": "^6.3.9"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "electron": "^33.2.0",
    "electron-builder": "26.9.0",
    "typescript": "^5.6.3"
  }
}
