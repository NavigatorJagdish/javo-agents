<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- Exclude hardware-backed encrypted prefs & database from cloud backup -->
        <exclude domain="sharedpref" path="javo_secure_prefs.xml" />
        <exclude domain="database" path="javo_agents.db" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="javo_secure_prefs.xml" />
    </device-transfer>
</data-extraction-rules>
